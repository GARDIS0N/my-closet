# ==============================================================================
# MyCloset — AI-Powered Online Closet Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# If Supabase credentials are not provided or unconfigured, MyCloset automatically
# activates Local Persistent Mode (IndexedDB) so photos and wardrobe data persist
# reliably without requiring third-party services.
# ==============================================================================

# [BROWSER-EXPOSED]: Supabase project URL for cloud authentication & storage
VITE_SUPABASE_URL=https://your-project.supabase.co

# [BROWSER-EXPOSED]: Supabase public anon key for database and storage access
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# [SERVER-SIDE ONLY, OPTIONAL]: Google Gemini AI API key for editorial styling advice
GEMINI_API_KEY=your-gemini-api-key

# Application host URL
APP_URL=http://localhost:5173
